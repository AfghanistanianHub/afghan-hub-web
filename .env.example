# Afghan Hub local-development environment template
# Copy to .env.local and fill with values for a NON-PRODUCTION development project.
# Never commit real access tokens, passwords, service-role keys, or production secrets.

# Required by browser/server Supabase clients
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Optional site-origin override.
# Local development falls back to http://localhost:3000 and production code falls back to https://app.apnbc.ca.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional anonymous smoke-test target used by scripts/smoke-public.mjs
SMOKE_BASE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Profile-privacy persona harness — ISOLATED NON-PRODUCTION TARGET ONLY
# -----------------------------------------------------------------------------
# scripts/security-profile-personas.mjs hard-refuses the Afghan Hub Production
# project ref. These values should come from disposable test personas in an
# isolated production-compatible database. Do not put production user tokens here.
SECURITY_TEST_SUPABASE_URL=https://YOUR_ISOLATED_PROJECT_REF.supabase.co
SECURITY_TEST_PUBLISHABLE_KEY=YOUR_ISOLATED_PUBLISHABLE_KEY
SECURITY_TEST_MEMBER_A_TOKEN=YOUR_DISPOSABLE_MEMBER_A_ACCESS_TOKEN
SECURITY_TEST_MEMBER_B_PROFILE_ID=00000000-0000-0000-0000-000000000000
SECURITY_TEST_HIDDEN_PROFILE_ID=00000000-0000-0000-0000-000000000000
SECURITY_TEST_INCOMPLETE_PROFILE_ID=00000000-0000-0000-0000-000000000000

# Optional persona-harness coverage
SECURITY_TEST_MEMBER_B_SEARCH_QUERY=
SECURITY_TEST_MODERATOR_TOKEN=
SECURITY_TEST_ADMIN_TOKEN=
